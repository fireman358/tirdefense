{
  "$schema": "https://workers.cloudflare.com/schema/wrangler.json",
  "name": "tirdefense",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
